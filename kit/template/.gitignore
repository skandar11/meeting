# Секреты — ключи, токены, пароли — никогда не уезжают в git.
# (Карточки с персональными данными — не секреты: они спокойно живут
# в приватном репозитории. Канон имени — secrets/, других вариантов нет.)
secrets/

# Черновое, что владелец держит при базе, но в git не хочет.
# ВНИМАНИЕ: это НЕ local/. local/ в мете — наоборот, обязан уехать:
# в нём журнал устройства базы, и потерять его нельзя.
scratch/

*.session
*.session-journal

__pycache__/
*.pyc
.venv/

.DS_Store
